# Blogger & Google Cloud Automation Environment Variables
# Copy this file to .env and fill in your actual values.

# 1. Target Blogger Blog ID (Engineer's Side Corner)
BLOGGER_BLOG_ID=1753031768743392930

# 2. Google Gemini API Key (Topic discovery, article drafting, diagram concepts)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Google OAuth 2.0 Web Client Credentials
# Get from: https://console.cloud.google.com/apis/credentials
BLOGGER_CLIENT_ID=your_client_id.apps.googleusercontent.com
BLOGGER_CLIENT_SECRET=your_client_secret

# 4. Permanent Offline OAuth Refresh Token
# Generated automatically by running: node get_refresh_token.js <CLIENT_ID> <CLIENT_SECRET>
BLOGGER_REFRESH_TOKEN=your_refresh_token_here

# 5. Daily Email Notification
NOTIFICATION_EMAIL=your_email@gmail.com
SMTP_USER=your_email@gmail.com
# Google App Password (16 characters from https://myaccount.google.com/apppasswords)
SMTP_PASS=your_gmail_app_password
# Optional: Resend API Key (alternative to SMTP)
RESEND_API_KEY=
